screen.PANINI_MENU.comment=Enables a post-processing step that replicates Panini projection, which is meant to help high FOVs look more natural

option.PANINI_PROJECTION_ENABLED=Panini Projection Enabled
option.PANINI_PROJECTION_ENABLED.comment=Enables a post-processing step that replicates Panini projection, which is meant to help high FOVs look more natural. The default strength of 0.55 seems best for Quake Pro (aka 110 degrees)
value.PANINI_PROJECTION_ENABLED.0=Off
value.PANINI_PROJECTION_ENABLED.1=On

option.PANINI_PROJECTION_STRENGTH=Panini Strength
option.PANINI_PROJECTION_STRENGTH.comment=Controls the strength of the Panini projection distortion

option.PANINI_SAMPLING_METHOD=Panini Sampling Method
option.PANINI_SAMPLING_METHOD.comment=Controls how pixels are moved from one location to another
value.PANINI_SAMPLING_METHOD.1=Smooth
value.PANINI_SAMPLING_METHOD.2=Sharp

option.PANINI_SHARPENING_STILL=Panini Sharpening (Still)
option.PANINI_SHARPENING_STILL.comment=If the sampling method is set to smooth then an extra sharping step is needed, and this controls the strength of that extra sharpening (when standing still)

option.PANINI_SHARPENING_MOVING=Panini Sharpening (Moving)
option.PANINI_SHARPENING_MOVING.comment=If the sampling method is set to smooth then an extra sharping step is needed, and this controls the strength of that extra sharpening (when moving)



screen.COMPATIBILITY_MENU=Compatibility

option.CLOUD_COMPATIBILITY=Cloud Compatibility
option.CLOUD_COMPATIBILITY.comment=Uses older (and likely slower) code to somewhat improve the compatibility of clouds
